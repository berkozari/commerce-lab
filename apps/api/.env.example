# Optional: native API (non-Docker), NOT production; never commit apps/api/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Use the SAME password as the existing local docker/.env PostgreSQL instance.
# If the password contains reserved URL characters, percent-encode it.
DATABASE_URL=postgresql://commercelab:REPLACE_WITH_EXISTING_DB_PASSWORD@127.0.0.1:5433/commercelab_dev
CORS_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
# Empty means Express does not trust reverse-proxy headers by default.
# TRUSTED_PROXY_CIDRS=
AUTH_JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_JWT_SECRET_OF_AT_LEAST_32_CHARACTERS
AUTH_CSRF_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_CSRF_SECRET_OF_AT_LEAST_32_CHARACTERS
