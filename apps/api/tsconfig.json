{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": [
        "src/**/*.ts",
        "src/lib/auth-crypto.js",
        "src/lib/auth-cookies.js"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}