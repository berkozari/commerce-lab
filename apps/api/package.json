    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "@types/supertest": "^6.0.0",
        "supertest": "^7.0.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0"
    }
}